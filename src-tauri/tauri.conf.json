{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermX",
  "version": "1.7.1",
  "identifier": "com.kroombox.termx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TermX",
        "width": 1180,
        "height": 740,
        "minWidth": 960,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Free, modern SSH client",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBQkNCNjNGNTY4NjJDQTkKUldTcExJWldQN2E4aWpwRS9obHpqS0tITkJUbWxRUmZMR0Q2alNwNlJKSzRPSWcrSk0yREdOeXEK",
      "endpoints": [
        "https://github.com/andiahmadnurmadani/TermX-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
